# Simple EOS Matchmaking Service - Environment Configuration
# See docs/setup.md#configuration for detailed explanation of all parameters

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# AccelByte Configuration (Required)
AB_BASE_URL=https://test.accelbyte.io
AB_NAMESPACE=accelbyte
AB_CLIENT_ID=
AB_CLIENT_SECRET=

# EOS SDK Configuration (Required)
EOS_PRODUCT_ID=
EOS_SANDBOX_ID=
EOS_DEPLOYMENT_ID=
EOS_CLIENT_ID=
EOS_CLIENT_SECRET=

# Service Configuration (Required)
BASE_PATH=/matchmaking

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Service Configuration
PLUGIN_GRPC_SERVER_AUTH_ENABLED=true

# Matchmaker Configuration (can also be set in appsettings.json)
# MATCHMAKER__MATCHSIZE=2
# MATCHMAKER__TICKINTERVALSECONDS=1
# MATCHMAKER__REQUESTTIMEOUTSECONDS=60

# Session Provider Configuration (can also be set in appsettings.json)
# SESSIONPROVIDER__MODE=create

# Session Finder Configuration (only used when SESSIONPROVIDER__MODE=find)
# SESSIONFINDER__BUCKETID=default
# SESSIONFINDER__MAXSEARCHRESULTS=10
# SESSIONFINDER__CLAIMEDSESSIONEXPIRATIONSECONDS=300

# Note: Environment variables override appsettings.json values.
# Double underscores (__) map to nested JSON configuration (e.g., MATCHMAKER__MATCHSIZE → MatchMaker:MatchSize)
# See docs/setup.md#configuration for details.
